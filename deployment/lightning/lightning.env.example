# LIGHTNING ONLY. Copy to .env on the Studio, never on the local laptop.
APP_ENV=lightning
LLM_PROVIDER=qwen
STT_PROVIDER=whisper
TTS_PROVIDER=kokoro
VAD_PROVIDER=silero
LLM_DEVICE=cpu
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
PROVIDER_HEALTHCHECK_ENABLED=false
WHISPER_MODEL_SIZE=base.en
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
MODEL_CACHE_DIR=/replace/with/persistent/models
TTS_DEVICE=cpu
TTS_MODEL_PATH=/replace/with/persistent/models/kokoro/kokoro-v1_0.pth
KOKORO_MODEL_PATH=/replace/with/persistent/models/kokoro/kokoro-v1_0.pth
KOKORO_CONFIG_PATH=/replace/with/persistent/models/kokoro/config.json
KOKORO_VOICE_PATH=/replace/with/persistent/models/kokoro/voices/af_heart.pt
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
KOKORO_LANG_CODE=a
VAD_DEVICE=cpu
VAD_MODEL_PATH=
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700
ALLOW_MODEL_DOWNLOADS=false
REALTIME_TRANSPORT=fastrtc
DATA_DIR=data
UPLOAD_DIR=data/uploads
RECORDING_DIR=data/recordings
TRANSCRIPT_DIR=data/transcripts
REPORT_DIR=data/reports
CACHE_DIR=data/cache
LOG_LEVEL=INFO
GRADIO_ANALYTICS_ENABLED=False
# Bind only behind the Studio's restricted HTTPS port access.
SERVER_NAME=0.0.0.0
SERVER_PORT=7860
