# LIGHTNING ONLY. Copy to .env on the Studio, never on the local laptop.
APP_ENV=lightning
LLM_PROVIDER=qwen
STT_PROVIDER=whisper
TTS_PROVIDER=kokoro
VAD_PROVIDER=silero
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b
PROVIDER_TIMEOUT_SECONDS=60
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
MODEL_CACHE_DIR=/replace/with/persistent/models
KOKORO_MODEL_PATH=/replace/with/persistent/models/kokoro/kokoro-v1_0.pth
KOKORO_CONFIG_PATH=/replace/with/persistent/models/kokoro/config.json
KOKORO_VOICE_PATH=/replace/with/persistent/models/kokoro/voices/af_heart.pt
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
KOKORO_LANG_CODE=a
VAD_SILENCE_SECONDS=0.7
VAD_THRESHOLD=0.5
ALLOW_MODEL_DOWNLOADS=false
REALTIME_TRANSPORT=fastrtc
DATA_DIR=data
UPLOAD_DIR=data/uploads
RECORDING_DIR=data/recordings
TRANSCRIPT_DIR=data/transcripts
REPORT_DIR=data/reports
CACHE_DIR=data/cache
LOG_LEVEL=INFO
GRADIO_ANALYTICS_ENABLED=False
# Bind only behind the Studio's restricted HTTPS port access.
SERVER_NAME=0.0.0.0
SERVER_PORT=7860
