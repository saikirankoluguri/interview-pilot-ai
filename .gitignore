# Credentials and local environment variants
.env
.env.*
!.env.example
*.env
!*.env.example
*.pem
*.key

# Private runtime data: keep directories, never their contents
/data/uploads/*
!/data/uploads/.gitkeep
/data/recordings/*
!/data/recordings/.gitkeep
/data/transcripts/*
!/data/transcripts/.gitkeep
/data/reports/*
!/data/reports/.gitkeep
/data/cache/*
!/data/cache/.gitkeep
# data/samples and tests/fixtures may contain synthetic data only.

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
dist/
build/
*.egg-info/

# AI artifacts must stay in cloud persistent storage
models/
checkpoints/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.h5

# Keep shareable VS Code configuration; ignore local secret overrides only
.vscode/*.local.json
.vscode/*secret*
.idea/
*.swp
*.swo
*~
*.tmp
*.log
.DS_Store
Thumbs.db
Desktop.ini
