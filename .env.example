# Safe local mock development. No API keys or secret values are required.
APP_ENV=local
LLM_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VAD_PROVIDER=mock
LLM_DEVICE=cpu
LLM_MODEL=qwen2.5:1.5b
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
PROVIDER_HEALTHCHECK_ENABLED=false
INTERVIEW_DEFAULT_DURATION_MINUTES=30
INTERVIEW_DEFAULT_DIFFICULTY=adaptive
DATA_DIR=data
UPLOAD_DIR=data/uploads
RECORDING_DIR=data/recordings
TRANSCRIPT_DIR=data/transcripts
REPORT_DIR=data/reports
CACHE_DIR=data/cache
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=20
LOG_LEVEL=INFO
COMPANY_RESEARCH_ENABLED=false
REALTIME_TRANSPORT=gradio
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False
ALLOW_MODEL_DOWNLOADS=false
# Optional runtime settings remain CPU-safe even though mocks are selected above.
WHISPER_MODEL_SIZE=base.en
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
TTS_DEVICE=cpu
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_MODEL_PATH=
VAD_DEVICE=cpu
VAD_MODEL_PATH=
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=700
VAD_SPEECH_PAD_MS=0
MAX_CANDIDATE_TURN_SECONDS=180
NO_SPEECH_TIMEOUT_SECONDS=30
NO_SPEECH_END_SECONDS=120
REALTIME_VAD_INTERVAL_MS=250
REALTIME_MIN_TRANSCRIPT_CHARACTERS=2
DEBUG_UI=false

# Lightning CPU example (uncomment only inside the intended Lightning Studio):
# APP_ENV=lightning
# LLM_PROVIDER=qwen
# STT_PROVIDER=whisper
# TTS_PROVIDER=kokoro
# VAD_PROVIDER=silero
# LLM_DEVICE=cpu
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen2.5:1.5b
# WHISPER_MODEL_SIZE=base.en
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# TTS_DEVICE=cpu
# VAD_DEVICE=cpu
