# Safe local mock development. No API keys or secret values are required.
APP_ENV=local
LLM_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VAD_PROVIDER=mock
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://127.0.0.1:11434
PROVIDER_TIMEOUT_SECONDS=60
INTERVIEW_DEFAULT_DURATION_MINUTES=30
INTERVIEW_DEFAULT_DIFFICULTY=adaptive
DATA_DIR=data
UPLOAD_DIR=data/uploads
RECORDING_DIR=data/recordings
TRANSCRIPT_DIR=data/transcripts
REPORT_DIR=data/reports
CACHE_DIR=data/cache
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=20
LOG_LEVEL=INFO
COMPANY_RESEARCH_ENABLED=false
REALTIME_TRANSPORT=gradio
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
GRADIO_ANALYTICS_ENABLED=False
ALLOW_MODEL_DOWNLOADS=false
# These are cloud adapter configuration defaults, NOT local download instructions.
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
VAD_SILENCE_SECONDS=0.7
